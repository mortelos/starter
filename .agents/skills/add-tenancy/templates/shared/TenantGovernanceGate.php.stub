<?php

declare(strict_types=1);

namespace App\Access;

use App\Contracts\GovernanceGate;
use App\Models\Policy;
use App\Models\Role;
use Illuminate\Contracts\Auth\Authenticatable;

/**
 * Fail-closed governance gate (R7), tenant-scoped, deny-by-default.
 *
 * Decision order — any miss is a deny:
 *  1. no user, or no initialized tenant            -> deny
 *  2. user has no role in the active tenant        -> deny (DeniedActor semantics)
 *  3. framework present -> delegate to Mortel\Actions\Policies\CheckPolicy
 *     UNCHANGED (R7), so the engine stays the source of truth in operate-mode
 *  4. framework absent  -> self-contained check over the host `policies` data:
 *     an explicit allow row is required; absence is denial
 *
 * Roles and policies are DB DATA (D11), editable by the owner via the existing
 * governance surface — never hardcoded role names, never config-in-code.
 */
final class TenantGovernanceGate implements GovernanceGate
{
    private const MANAGE_ACTION = 'governance.manage';

    public function canManage(?Authenticatable $user): bool
    {
        if ($user === null || ! tenancy()->initialized) {
            return false;
        }

        $tenantKey = tenant()?->getTenantKey();

        if ($tenantKey === null) {
            return false;
        }

        $role = $this->roleFor($user, (string) $tenantKey);

        if ($role === null) {
            return false;
        }

        if ($this->frameworkPolicyEngineAvailable()) {
            return $this->frameworkAllows((string) $role->getKey());
        }

        return $this->hostAllows((string) $role->getKey());
    }

    private function roleFor(Authenticatable $user, string $tenantKey): ?Role
    {
        if (! method_exists($user, 'tenants')) {
            return null;
        }

        $membership = $user->tenants()->whereKey($tenantKey)->first();

        $roleId = $membership?->getAttribute('pivot')?->role_id ?? null;

        if (! is_string($roleId) || $roleId === '') {
            return null;
        }

        return Role::query()->whereKey($roleId)->first();
    }

    private function frameworkPolicyEngineAvailable(): bool
    {
        return class_exists(\Mortel\Actions\Policies\CheckPolicy::class)
            && enum_exists(\Mortel\Enums\PolicyScope::class);
    }

    private function frameworkAllows(string $roleId): bool
    {
        $result = app(\Mortel\Actions\Policies\CheckPolicy::class)->check(
            roleId: $roleId,
            action: self::MANAGE_ACTION,
            scope: \Mortel\Enums\PolicyScope::Policy,
        );

        return (bool) $result->allowed;
    }

    private function hostAllows(string $roleId): bool
    {
        return Policy::query()
            ->where('role_id', $roleId)
            ->where('action', self::MANAGE_ACTION)
            ->where('effect', 'allow')
            ->exists();
    }
}

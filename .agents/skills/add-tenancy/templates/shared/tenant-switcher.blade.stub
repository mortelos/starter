{{--
    Tenant switcher — reinstated by add-tenancy.

    Shown ONLY when the signed-in user belongs to more than one tenant (R: D5).
    With slug-keyed identification, switching is just navigating to the other
    tenant's URL, so each entry is a link to that tenant's home (/{slug}).

    Place at resources/views/livewire/shared/tenant-switcher.blade.php and include
    it from topbar.blade.php (see the topbar snippet in role-policy-hook.md). The
    stripped starter has NO switcher, so this is an addition, not an edit.
--}}
@php
    $user = auth()->user();
    $tenants = $user?->tenants()->orderBy('slug')->get() ?? collect();
    $current = function_exists('tenant') && tenancy()->initialized ? tenant()?->getTenantKey() : null;
@endphp

@if ($tenants->count() > 1)
    <flux:dropdown position="bottom" align="start">
        <flux:button variant="ghost" size="sm" icon-trailing="chevron-down">
            {{ optional($tenants->firstWhere(fn ($t) => $t->getTenantKey() === $current))->slug ?? 'Selecteer organisatie' }}
        </flux:button>

        <flux:menu>
            <flux:menu.heading>Organisaties</flux:menu.heading>

            @foreach ($tenants as $tenant)
                <flux:menu.item
                    href="{{ url('/' . $tenant->slug) }}"
                    icon="{{ $tenant->getTenantKey() === $current ? 'check' : 'building-office' }}"
                    wire:navigate
                >
                    {{ $tenant->slug }}
                </flux:menu.item>
            @endforeach
        </flux:menu>
    </flux:dropdown>
@endif

// === Merge into app/Providers/StarterServiceProvider.php ===
//
// Add a register() method (or merge into the existing one). The existing boot()
// that does view-namespacing stays untouched. Add these imports at the top:
//
//   use App\Access\TenantGovernanceGate;
//   use App\Contracts\GovernanceGate;
//   use App\Support\StanclTenantResolver;

public function register(): void
{
    // R1: fill framework's TenantResolver seam from the host, GUARDED so a
    // framework-absent install never autoloads StanclTenantResolver (which
    // references the framework-only interface). We bind unconditionally inside
    // the guard: if framework already bound NullTenantResolver, this overrides
    // it; if we bind first, framework's `if (! bound)` skips its default.
    if (interface_exists(\Mortel\Contracts\TenantResolver::class)) {
        $this->app->scoped(
            \Mortel\Contracts\TenantResolver::class,
            StanclTenantResolver::class,
        );
    }

    // R7: bind the host governance gate behind a contract. config/starter.php
    // points `governance.access_resolver` at GovernanceGate::class; the
    // concrete TenantGovernanceGate is fail-closed (deny-by-default).
    $this->app->bind(GovernanceGate::class, TenantGovernanceGate::class);
}

// === Then in config/starter.php, set the governance gate ===
//
//   'governance' => [
//       'resolver' => ...,
//       'access_resolver' => \App\Contracts\GovernanceGate::class, // was null
//       ...
//   ],
//
// governance.blade.php already calls app($resolver)->canManage(auth()->user())
// and treats null as deny — so pointing it at the bound contract is all that is
// needed to activate the gate.

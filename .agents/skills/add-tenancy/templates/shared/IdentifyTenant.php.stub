<?php

declare(strict_types=1);

namespace App\Http\Middleware;

use App\Models\Tenant;
use Closure;
use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\Response;

/**
 * Web tenant identification (R3) — slug-keyed.
 *
 * Resolves the tenant from a `{tenant}` route parameter, falling back to the
 * first path segment, and initializes stancl tenancy. Register it on the tenant
 * route group and order it BEFORE framework's ResolveRole / EnforcePolicy /
 * EnforceTrustLevel so those see an initialized tenant. Framework middleware is
 * absent on a build-only install, so this must work standalone too — it does:
 * it only touches stancl + the host Tenant model.
 *
 * Both drivers use this. For `database` it triggers the connection swap; for
 * `row` it sets the active tenant the TenantScope reads.
 */
final class IdentifyTenant
{
    public function handle(Request $request, Closure $next): Response
    {
        $slug = $request->route('tenant');

        if (! is_string($slug) || $slug === '') {
            $slug = $request->segment(1);
        }

        if (is_string($slug) && $slug !== '') {
            $tenant = Tenant::query()->where('slug', $slug)->first();

            abort_if($tenant === null, 404);

            tenancy()->initialize($tenant);
        }

        return $next($request);
    }
}

<?php

declare(strict_types=1);

namespace App\Models;

use Stancl\Tenancy\Contracts\TenantWithDatabase;
use Stancl\Tenancy\Database\Concerns\HasDatabase;
use Stancl\Tenancy\Database\Models\Tenant as BaseTenant;

/**
 * Host tenant model.
 *
 * Slug-keyed (R3): the public identifier is a human-readable `slug`, not the
 * opaque stancl id. `getCustomColumns()` promotes `slug` to a real column;
 * everything else stancl keeps in the `data` JSON blob.
 *
 * Implements TenantWithDatabase / HasDatabase so stancl can create, migrate
 * and drop a database per tenant (the `database` driver). The `row` driver
 * keeps the same model but never triggers the database lifecycle — see the
 * skill's row-driver.md.
 */
final class Tenant extends BaseTenant implements TenantWithDatabase
{
    use HasDatabase;

    /**
     * Columns promoted out of the `data` JSON blob into real table columns.
     *
     * @return array<int, string>
     */
    public static function getCustomColumns(): array
    {
        return [
            'id',
            'slug',
        ];
    }
}

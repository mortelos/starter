<?php

declare(strict_types=1);

namespace App\Support;

use Mortel\Contracts\TenantResolver;

/**
 * Host implementation of the framework's tenant-resolver seam (R1).
 *
 * Framework binds Mortel\Contracts\NullTenantResolver only
 * `if (! $this->app->bound(TenantResolver::class))`
 * (mortelos/framework MortelServiceProvider.php:83-84). Binding this class
 * fills that seam from the host so framework reads the live stancl tenant.
 *
 * IMPORTANT: this file references Mortel\Contracts\TenantResolver, which only
 * exists when mortelos/framework is installed. The binding in
 * StarterServiceProvider is therefore guarded with interface_exists(); when
 * framework is absent this class is never autoloaded and tenancy still runs on
 * stancl alone. Do NOT typehint or instantiate it anywhere unguarded.
 */
final class StanclTenantResolver implements TenantResolver
{
    public function id(): ?string
    {
        if (! tenancy()->initialized) {
            return null;
        }

        $key = tenant()?->getTenantKey();

        return $key === null ? null : (string) $key;
    }

    public function initialized(): bool
    {
        return (bool) tenancy()->initialized;
    }

    public function data(string $key, mixed $default = null): mixed
    {
        $tenant = tenant();

        if ($tenant === null) {
            return $default;
        }

        return $tenant->getAttribute($key) ?? $default;
    }
}

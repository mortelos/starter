# Merge into config/database.php  —  DATABASE driver only.
#
# stancl clones `tenancy.database.template_tenant_connection` for each tenant
# database. With template_tenant_connection => null (our default) it clones the
# CENTRAL connection's settings and just swaps the database name to
# `<prefix><tenant-id><suffix>`. So in most cases you do NOT need a separate
# connection block — keep your existing default connection as the central one.
#
# Add a dedicated `tenant` template only if tenant DBs need different settings
# (different host, charset, etc). Example (MySQL):

'connections' => [

    // ... your existing 'sqlite' / 'mysql' connections (the CENTRAL store) ...

    'tenant' => [
        'driver' => 'mysql',
        'host' => env('DB_HOST', '127.0.0.1'),
        'port' => env('DB_PORT', '3306'),
        'database' => null,              // set per-tenant by stancl, leave null
        'username' => env('DB_USERNAME', 'root'),
        'password' => env('DB_PASSWORD', ''),
        'charset' => 'utf8mb4',
        'collation' => 'utf8mb4_unicode_ci',
        'prefix' => '',
        'strict' => true,
    ],

],

# Then point the template at it in config/tenancy.php:
#   'template_tenant_connection' => 'tenant',
#
# --- sqlite-per-tenant (tests / lightweight dev) ---
# Keep template_tenant_connection => null and set the central connection to
# sqlite. The SQLiteDatabaseManager writes one file per tenant under
# database_path(). With 'suffix' => '.sqlite' in tenancy.php you get
# database/tenant<id>.sqlite files. No extra connection block needed.

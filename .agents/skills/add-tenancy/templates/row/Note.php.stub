<?php

declare(strict_types=1);

namespace App\Models;

use App\Models\Concerns\BelongsToTenant;
use Illuminate\Database\Eloquent\Model;

/**
 * Example tenant-scoped model (ROW driver).
 *
 * The BelongsToTenant trait is the whole story: it auto-fills `tenant_id` on
 * create and scopes every read to the active tenant. Put the trait on every
 * scoped model; leave it off the `--shared` ones (users, settings, ...).
 *
 * Replace with your real domain models.
 */
final class Note extends Model
{
    use BelongsToTenant;

    protected $fillable = [
        'body',
    ];
}

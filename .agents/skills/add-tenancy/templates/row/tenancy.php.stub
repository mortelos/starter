<?php

declare(strict_types=1);

use App\Models\Tenant;

/**
 * stancl/tenancy config — ROW driver (single-DB, row-scoped).
 *
 * Identical to the database driver EXCEPT the `bootstrappers` array, which has
 * DatabaseTenancyBootstrapper removed. That single omission is what makes this
 * row-scoping instead of database-per-tenant. stancl is still used for
 * identification (the central `tenants` table + middleware), so `tenancy()`
 * and `tenant()` work and `tenancy()->initialized` flips per request.
 */
return [
    'tenant_model' => Tenant::class,
    'id_generator' => Stancl\Tenancy\UUIDGenerator::class,

    'tenant_key_column' => 'slug',

    'central_domains' => [
        env('CENTRAL_DOMAIN', 'localhost'),
    ],

    /*
     | ROW driver: no DatabaseTenancyBootstrapper. Isolation is the per-row
     | tenant_id + TenantScope (see app/Models/Concerns/BelongsToTenant.php),
     | not a connection swap.
     */
    'bootstrappers' => [
        Stancl\Tenancy\Bootstrappers\CacheTenancyBootstrapper::class,
        Stancl\Tenancy\Bootstrappers\FilesystemTenancyBootstrapper::class,
        Stancl\Tenancy\Bootstrappers\QueueTenancyBootstrapper::class,
    ],

    'cache' => [
        'tag_base' => 'tenant',
    ],

    'filesystem' => [
        'suffix_base' => 'tenant',
        'disks' => ['local', 'public'],
        'root_override' => [
            'local' => '%storage_path%/app/',
            'public' => '%storage_path%/app/public/',
        ],
        'suffix_storage_path' => true,
    ],

    // No `database` block, no migration_parameters: there are no per-tenant
    // databases or tenant migrations. All tables live in the single default
    // connection and migrate with a plain `php artisan migrate`.
];

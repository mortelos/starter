<?php

declare(strict_types=1);

namespace App\Models\Scopes;

use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Scope;

/**
 * Global scope for the ROW driver.
 *
 * When tenancy is initialized, every query on a BelongsToTenant model is
 * filtered to the active tenant. In central context (no tenant initialized —
 * artisan, seeders, cross-tenant admin) the scope is a deliberate no-op so
 * those callers see all rows.
 *
 * Sharp edge: a web request that reaches a scoped model WITHOUT identification
 * having initialized tenancy is unscoped and would leak across tenants. The
 * identification middleware must run on every tenant route; treat un-identified
 * access to scoped data as admin-only.
 */
final class TenantScope implements Scope
{
    public function apply(Builder $builder, Model $model): void
    {
        if (! tenancy()->initialized) {
            return;
        }

        $tenant = tenant();

        if ($tenant === null) {
            return;
        }

        $builder->where(
            $model->qualifyColumn($model->getTenantKeyName()),
            $tenant->getTenantKey(),
        );
    }
}

#!/usr/bin/env python3
#
# vet-agent — run ./vendor/bin/vet the way a developer would in a terminal,
# and pick "Automatically, with my coding agent reading the changes first".
#
# Vet only asks its questions on a TTY, so a coding agent cannot answer them
# directly. This script gives vet a pseudo-terminal and answers for it:
#
#   bin/vet-agent              trust only the packages the agent review cleared
#   bin/vet-agent --trust-all  also trust the flagged ones (only after a human said so)
#
# Exit code 0 means every package is trusted; 1 means something is still left.

import os, pty, re, select, signal, struct, sys, time, fcntl, termios

TRUST_ALL = "--trust-all" in sys.argv[1:]
TIMEOUT = 1800  # ponytail: one fixed limit; a large framework bump can take a while

pid, fd = pty.fork()
if pid == 0:
    os.environ["TERM"] = "xterm-256color"
    os.execvp("./vendor/bin/vet", ["./vendor/bin/vet"])

fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 50, 160, 0, 0))

steps = [
    ("Automatically, with my coding agent", "\x1b[B"),  # arrow down to the agent option
    ("● Automatically", "\r"),                           # confirm it
    ("Which model", "\r"),                               # the agent's default model
    ("Press the space bar to pick", None),               # the trust list, answered below
]
buffer, step, start = "", 0, time.time()

while time.time() - start < TIMEOUT:
    if not select.select([fd], [], [], 1)[0]:
        continue
    try:
        chunk = os.read(fd, 65536).decode("utf-8", "replace")
    except OSError:
        break
    if not chunk:
        break
    sys.stdout.write(chunk)
    sys.stdout.flush()
    buffer += chunk
    plain = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", buffer)
    if step < len(steps) and steps[step][0] in plain:
        time.sleep(0.5)
        answer = steps[step][1]
        if answer is None:
            # The agent's cleared packages are preselected; ctrl+a picks the rest.
            # Send it on its own: prompts reads one key per read, and "\x01\r" is no key.
            if TRUST_ALL and "◻" in plain:
                os.write(fd, b"\x01")
                time.sleep(0.5)
            answer = "\r"
        os.write(fd, answer.encode())
        step, buffer = step + 1, ""
else:
    os.kill(pid, signal.SIGKILL)
    print(f"\nvet-agent: gave up after {TIMEOUT}s", file=sys.stderr)

_, status = os.waitpid(pid, 0)
sys.exit(os.waitstatus_to_exitcode(status) if os.WIFEXITED(status) else 1)

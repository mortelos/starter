{
    "name": "mortelos/starter",
    "description": "Starter shell contracts for MortelOS workspaces",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "livewire/livewire": "^4.0",
        "mortelos/ui": "^0.2"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Mortelos\\Starter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mortelos\\Starter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:arch": "vendor/bin/pest --filter=Architecture",
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mortelos\\Starter\\MortelosStarterServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
